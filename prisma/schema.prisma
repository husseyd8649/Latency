generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String       @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime     @default(now())
  passwordHash  String?
  accounts      Account[]
  monitors      Monitor[]
  regions       Region[]
  sessions      Session[]    @relation("UserSessions")
  loginHistory  LoginHistory[] @relation("UserLogins")
  statusPages   StatusPage[]
  webhooks      Webhook[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation("UserSessions", fields: [userId], references: [id], onDelete: Cascade)
  userAgent    String?
  ipAddress    String?
  location     String?
  deviceType   String?
  
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())
  
  @@index([userId])
  @@index([createdAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Monitor {
  id              String      @id @default(cuid())
  userId          String
  name            String
  type            MonitorType
  target          String
  intervalSeconds Int         @default(300)
  timeoutMs       Int         @default(10000)
  expectedStatus  Int?
  isPaused        Boolean     @default(false)
  lastCheckedAt   DateTime?
  nextCheckAt     DateTime?
  createdAt       DateTime    @default(now())
  regionId        String?
  lastStatus      CheckStatus?
  lastResponseTimeMs Int?
  lastError       String?
  region          Region?  @relation(fields: [regionId], references: [id])
  checks          Check[]
  incidents       Incident[]
  accept401       Boolean @default(false)
  accept403       Boolean @default(false)
  accept429       Boolean @default(false)
  isProtected     Boolean @default(false)
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  // PERFORMANCE: For cron job - quickly find due monitors
  @@index([nextCheckAt, isPaused])
  @@index([userId])
  @@index([regionId])
}

model Region {
  id        String    @id @default(cuid())
  userId    String
  name      String
  slug      String
  color     String    @default("#6366f1")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  monitors  Monitor[]

  @@unique([userId, slug])
  @@index([userId])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String
  action      String   // "MONITOR_CREATE", "MONITOR_UPDATE", "INCIDENT_ACK"
  entityType  String   // "Monitor", "Incident", "StatusPage"
  entityId    String?
  oldValue    Json?
  newValue    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  
  @@index([userId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
}

model MaintenanceWindow {
  id             String   @id @default(cuid())
  userId         String
  name           String   // "Tuesday Night Fiber Maintenance"
  description    String?
  monitorIds     String[] // Empty = all monitors
  startsAt       DateTime
  endsAt         DateTime
  suppressAlerts Boolean  @default(true)
  createdAt      DateTime @default(now())
  
  @@index([userId])
  @@index([startsAt, endsAt])
  @@index([userId, startsAt, endsAt])
}

model Check {
  id             String      @id @default(cuid())
  monitorId      String
  checkedAt      DateTime    @default(now())
  status         CheckStatus
  responseTimeMs Int?
  statusCode     Int?
  error          String?
  monitor        Monitor     @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  // PERFORMANCE: Critical for dashboard stats, sparklines, monitor history
  @@index([monitorId, checkedAt(sort: Desc)])
  // PERFORMANCE: For time-range queries (cleanup, aggregated stats)
  @@index([checkedAt])
}

model Incident {
  id         String    @id @default(cuid())
  monitorId  String
  startedAt  DateTime  @default(now())
  resolvedAt DateTime?
  cause      String?
  monitor    Monitor   @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  // PERFORMANCE: For incident list queries per monitor
  @@index([monitorId, startedAt(sort: Desc)])
  // PERFORMANCE: For "open incidents" queries (resolvedAt IS NULL)
  @@index([resolvedAt, startedAt])
}

model StatusPage {
  id         String   @id @default(cuid())
  userId     String
  slug       String   @unique
  title      String
  description   String?
  monitorIds String[]
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptions StatusPageSubscription[]

  @@index([slug])
  @@index([userId])
}

model Webhook {
  id        String   @id @default(cuid())
  userId    String
  url       String
  secret    String
  events    String[]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoginHistory {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation("UserLogins", fields: [userId], references: [id], onDelete: Cascade)
  
  userAgent    String?
  ipAddress    String?
  location     String?
  deviceType   String?
  
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())
  
  // PERFORMANCE: For admin analytics - quickly fetch user login history
  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt])
}

model StatusPageSubscription {
  id           String     @id @default(cuid())
  statusPageId String
  email        String
  createdAt    DateTime   @default(now())
  statusPage   StatusPage @relation(fields: [statusPageId], references: [id], onDelete: Cascade)

  @@unique([statusPageId, email])
  @@index([statusPageId])
}

model ApiKey {
  id          String    @id @default(cuid())
  userId      String
  name        String    // "Terraform Production", "NOC Dashboard"
  keyPrefix   String    // "lat_live_" (for lookup)
  keyHash     String    // bcrypt hash of the secret part
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  
  @@index([userId])
  @@index([keyPrefix])
  @@unique([keyHash])
}

model EscalationPolicy {
  id          String   @id @default(cuid())
  userId      String
  name        String   // "Critical Infrastructure - Tier 1"
  description String?
  isDefault   Boolean  @default(false) // Apply to all new monitors
  steps       Json     // Array of {waitMinutes: number, channel: "webhook", target: string, messageTemplate?: string}
  monitorIds  String[] // Empty = all monitors
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([userId])
  @@index([isDefault])
}

model EscalationEvent {
  id          String   @id @default(cuid())
  incidentId  String
  policyId    String
  stepIndex   Int      // Which step in the policy (0, 1, 2...)
  channel     String   // "webhook", "email" (future), "sms" (future)
  target      String   // URL, email address, phone number
  status      String   @default("pending") // pending, sent, failed, acknowledged
  sentAt      DateTime?
  error       String?
  createdAt   DateTime @default(now())
  
  @@index([incidentId, status])
  @@index([createdAt])
}

enum MonitorType {
  HTTP
  TCP
  SSL
}

enum CheckStatus {
  UP
  DOWN
}