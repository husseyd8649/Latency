generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String       @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime     @default(now())
  passwordHash  String?
  accounts      Account[]
  monitors      Monitor[]
  regions   Region[]
  sessions      Session[]
  statusPages   StatusPage[]
  webhooks      Webhook[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Monitor {
  id              String      @id @default(cuid())
  userId          String
  name            String
  type            MonitorType
  target          String
  intervalSeconds Int         @default(300)
  timeoutMs       Int         @default(10000)
  expectedStatus  Int?
  isPaused        Boolean     @default(false)
  lastCheckedAt   DateTime?
  nextCheckAt     DateTime?
  createdAt       DateTime    @default(now())
  regionId    String?
  lastStatus         CheckStatus?
  lastResponseTimeMs Int?
  lastError          String?
  region      Region?  @relation(fields: [regionId], references: [id])
  checks          Check[]
  incidents       Incident[]
  accept401 Boolean @default(false) // Unauthorized (auth endpoint)
  accept403 Boolean @default(false) // Forbidden (WAF/edge protection)
  accept429 Boolean @default(false) // Too Many Requests (rate limit)
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([nextCheckAt])
  @@index([regionId])
}

model Region {
  id        String    @id @default(cuid())
  userId    String
  name      String
  slug      String
  color     String    @default("#6366f1")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  monitors  Monitor[]

  @@unique([userId, slug])
  @@index([userId])
}

model Check {
  id             String      @id @default(cuid())
  monitorId      String
  checkedAt      DateTime    @default(now())
  status         CheckStatus
  responseTimeMs Int?
  statusCode     Int?
  error          String?
  monitor        Monitor     @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId, checkedAt(sort: Desc)])
}

model Incident {
  id         String    @id @default(cuid())
  monitorId  String
  startedAt  DateTime  @default(now())
  resolvedAt DateTime?
  cause      String?
  monitor    Monitor   @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId])
}

model StatusPage {
  id         String   @id @default(cuid())
  userId     String
  slug       String   @unique
  title      String
  monitorIds String[]
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Webhook {
  id        String   @id @default(cuid())
  userId    String
  url       String
  secret    String
  events    String[]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum MonitorType {
  HTTP
  TCP
  SSL
}

enum CheckStatus {
  UP
  DOWN
}
