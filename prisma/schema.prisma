generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String       @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime     @default(now())
  passwordHash  String?
  accounts      Account[]
  monitors      Monitor[]
  regions       Region[]
  sessions      Session[]    @relation("UserSessions")
  loginHistory  LoginHistory[] @relation("UserLogins")
  statusPages   StatusPage[]
  webhooks      Webhook[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation("UserSessions", fields: [userId], references: [id], onDelete: Cascade)
  userAgent    String?
  ipAddress    String?
  location     String?
  deviceType   String?
  
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())
  
  @@index([userId])
  @@index([createdAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Monitor {
  id              String      @id @default(cuid())
  userId          String
  name            String
  type            MonitorType
  target          String
  intervalSeconds Int         @default(300)
  timeoutMs       Int         @default(10000)
  expectedStatus  Int?
  isPaused        Boolean     @default(false)
  lastCheckedAt   DateTime?
  nextCheckAt     DateTime?
  createdAt       DateTime    @default(now())
  regionId        String?
  lastStatus      CheckStatus?
  lastResponseTimeMs Int?
  lastError       String?
  region          Region?  @relation(fields: [regionId], references: [id])
  checks          Check[]
  incidents       Incident[]
  accept401       Boolean @default(false)
  accept403       Boolean @default(false)
  accept429       Boolean @default(false)
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  // PERFORMANCE: For cron job - quickly find due monitors
  @@index([nextCheckAt, isPaused])
  @@index([userId])
  @@index([regionId])
}

model Region {
  id        String    @id @default(cuid())
  userId    String
  name      String
  slug      String
  color     String    @default("#6366f1")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  monitors  Monitor[]

  @@unique([userId, slug])
  @@index([userId])
}

model Check {
  id             String      @id @default(cuid())
  monitorId      String
  checkedAt      DateTime    @default(now())
  status         CheckStatus
  responseTimeMs Int?
  statusCode     Int?
  error          String?
  monitor        Monitor     @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  // PERFORMANCE: Critical for dashboard stats, sparklines, monitor history
  @@index([monitorId, checkedAt(sort: Desc)])
  // PERFORMANCE: For time-range queries (cleanup, aggregated stats)
  @@index([checkedAt])
}

model Incident {
  id         String    @id @default(cuid())
  monitorId  String
  startedAt  DateTime  @default(now())
  resolvedAt DateTime?
  cause      String?
  monitor    Monitor   @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  // PERFORMANCE: For incident list queries per monitor
  @@index([monitorId, startedAt(sort: Desc)])
  // PERFORMANCE: For "open incidents" queries (resolvedAt IS NULL)
  @@index([resolvedAt, startedAt])
}

model StatusPage {
  id         String   @id @default(cuid())
  userId     String
  slug       String   @unique
  title      String
  monitorIds String[]
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Webhook {
  id        String   @id @default(cuid())
  userId    String
  url       String
  secret    String
  events    String[]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoginHistory {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation("UserLogins", fields: [userId], references: [id], onDelete: Cascade)
  
  userAgent    String?
  ipAddress    String?
  location     String?
  deviceType   String?
  
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())
  
  // PERFORMANCE: For admin analytics - quickly fetch user login history
  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt])
}

enum MonitorType {
  HTTP
  TCP
  SSL
}

enum CheckStatus {
  UP
  DOWN
}